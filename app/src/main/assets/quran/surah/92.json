[{"numberInSurah":1,"numberInQuran":6059,"textArabic":"وَالَّيْلِ اِذَا يَغْشٰىۙ","textLatin":"Wal-laili iżā yagsyā.","translationEn":"","translationId":"Demi malam apabila menutupi (cahaya siang),","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6060,"textArabic":"وَالنَّهَارِ اِذَا تَجَلّٰىۙ","textLatin":"Wan-nahāri iżā tajallā.","translationEn":"","translationId":"demi siang apabila terang benderang,","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6061,"textArabic":"وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰىٓ ۙ","textLatin":"Wa mā khalaqaż-żakara wal-unṡā.","translationEn":"","translationId":"dan demi penciptaan laki-laki dan perempuan,","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6062,"textArabic":"اِنَّ سَعْيَكُمْ لَشَتّٰىۗ","textLatin":"Inna sa‘yakum lasyattā.","translationEn":"","translationId":"sesungguhnya usahamu benar-benar beraneka ragam.","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":6063,"textArabic":"فَاَمَّا مَنْ اَعْطٰى وَاتَّقٰىۙ","textLatin":"Fa ammā man a‘ṭā wattaqā.","translationEn":"","translationId":"Siapa yang memberikan (hartanya di jalan Allah) dan bertakwa","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":6064,"textArabic":"وَصَدَّقَ بِالْحُسْنٰىۙ","textLatin":"Wa ṣaddaqa bil-ḥusnā.","translationEn":"","translationId":"serta membenarkan adanya (balasan) yang terbaik (surga),","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":6065,"textArabic":"فَسَنُيَسِّرُهٗ لِلْيُسْرٰىۗ","textLatin":"Fa sanuyassiruhū lil-yusrā.","translationEn":"","translationId":"Kami akan melapangkan baginya jalan kemudahan (kebahagiaan).","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":6066,"textArabic":"وَاَمَّا مَنْۢ بَخِلَ وَاسْتَغْنٰىۙ","textLatin":"Wa ammā man bakhila wastagnā.","translationEn":"","translationId":"Adapun orang yang kikir dan merasa dirinya cukup (tidak perlu pertolongan Allah)","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":6067,"textArabic":"وَكَذَّبَ بِالْحُسْنٰىۙ","textLatin":"Wa każżaba bil-ḥusnā.","translationEn":"","translationId":"serta mendustakan (balasan) yang terbaik,","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":6068,"textArabic":"فَسَنُيَسِّرُهٗ لِلْعُسْرٰىۗ","textLatin":"Fa sanuyassiruhū lil-‘usrā.","translationEn":"","translationId":"Kami akan memudahkannya menuju jalan kesengsaraan.","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":6069,"textArabic":"وَمَا يُغْنِيْ عَنْهُ مَالُهٗٓ اِذَا تَرَدّٰىٓۙ","textLatin":"Wa mā yugnī ‘anhu māluhū iżā taraddā.","translationEn":"","translationId":"Hartanya tidak bermanfaat baginya apabila dia telah binasa.","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":6070,"textArabic":"اِنَّ عَلَيْنَا لَلْهُدٰىۖ","textLatin":"Inna ‘alainā lal-hudā.","translationEn":"","translationId":"Sesungguhnya Kamilah yang (berhak) memberi petunjuk.","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":6071,"textArabic":"وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُوْلٰىۗ","textLatin":"Wa inna lanā lal-ākhirata wal-ūlā.","translationEn":"","translationId":"Sesungguhnya milik Kamilah akhirat dan dunia.","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":6072,"textArabic":"فَاَنْذَرْتُكُمْ نَارًا تَلَظّٰىۚ","textLatin":"Fa anżartukum nāran talaẓẓā.","translationEn":"","translationId":"Aku memperingatkanmu dengan neraka yang menyala-nyala.","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":6073,"textArabic":"لَا يَصْلٰىهَآ اِلَّا الْاَشْقَىۙ","textLatin":"Lā yaṣlāhā illal-asyqā.","translationEn":"","translationId":"Tidak masuk ke dalamnya kecuali orang yang paling celaka,","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":6074,"textArabic":"الَّذِيْ كَذَّبَ وَتَوَلّٰىۗ","textLatin":"Allażī każżaba wa tawallā.","translationEn":"","translationId":"yang mendustakan (kebenaran) dan berpaling (dari keimanan).","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":6075,"textArabic":"وَسَيُجَنَّبُهَا الْاَتْقَىۙ","textLatin":"Wa sayujannabuhal-atqā.","translationEn":"","translationId":"Akan dijauhkan darinya (neraka) orang yang paling bertakwa,","tafsirId":"","juz":30},{"numberInSurah":18,"numberInQuran":6076,"textArabic":"الَّذِيْ يُؤْتِيْ مَالَهٗ يَتَزَكّٰىۚ","textLatin":"Allażī yu'tī mālahū yatazakkā.","translationEn":"","translationId":"yang menginfakkan hartanya (di jalan Allah) untuk membersihkan (diri dari sifat kikir dan tamak).","tafsirId":"","juz":30},{"numberInSurah":19,"numberInQuran":6077,"textArabic":"وَمَا لِاَحَدٍ عِنْدَهٗ مِنْ نِّعْمَةٍ تُجْزٰىٓۙ","textLatin":"Wa mā li'aḥadin ‘indahū min ni‘matin tujzā.","translationEn":"","translationId":"Tidak ada suatu nikmat pun yang diberikan seseorang kepadanya yang harus dibalas,","tafsirId":"","juz":30},{"numberInSurah":20,"numberInQuran":6078,"textArabic":"اِلَّا ابْتِغَاۤءَ وَجْهِ رَبِّهِ الْاَعْلٰىۚ","textLatin":"Illabtigā'a wajhi rabbihil-a‘lā.","translationEn":"","translationId":"kecuali (dia memberikannya semata-mata) karena mencari keridaan Tuhannya Yang Maha Tinggi.","tafsirId":"","juz":30},{"numberInSurah":21,"numberInQuran":6079,"textArabic":"وَلَسَوْفَ يَرْضٰى ࣖ","textLatin":"Wa lasaufa yarḍā.","translationEn":"","translationId":"Sungguh, kelak dia akan mendapatkan kepuasan (menerima balasan amalnya).","tafsirId":"","juz":30}]