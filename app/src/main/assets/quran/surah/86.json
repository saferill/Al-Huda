[{"numberInSurah":1,"numberInQuran":5932,"textArabic":"وَالسَّمَاۤءِ وَالطَّارِقِۙ ","textLatin":"Was-samā'i waṭ-ṭāriq(i).","translationEn":"","translationId":"Demi langit dan yang datang pada malam hari.","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":5933,"textArabic":"وَمَآ اَدْرٰىكَ مَا الطَّارِقُۙ ","textLatin":"Wa mā adrāka maṭ-ṭāriq(u).","translationEn":"","translationId":"Tahukah kamu apakah yang datang pada malam hari itu?","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":5934,"textArabic":"النَّجْمُ الثَّاقِبُۙ ","textLatin":"An-najmuṡ-ṡāqib(u).","translationEn":"","translationId":"(Itulah) bintang yang bersinar tajam.","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":5935,"textArabic":"اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌۗ ","textLatin":"In kullu nafsil lammā ‘alaihā ḥāfiẓ(un).","translationEn":"","translationId":"Setiap orang pasti ada penjaganya.","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":5936,"textArabic":"فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ ","textLatin":"Falyanẓuril-insānu mimma khuliq(a).","translationEn":"","translationId":"Hendaklah manusia memperhatikan dari apa dia diciptakan.","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":5937,"textArabic":"خُلِقَ مِنْ مَّاۤءٍ دَافِقٍۙ ","textLatin":"Khuliqa mim mā'in dāfiq(in).","translationEn":"","translationId":"Dia diciptakan dari air (mani) yang memancar,","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":5938,"textArabic":"يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَاۤىِٕبِۗ ","textLatin":"Yakhruju mim bainiṣ-ṣulbi wat-tarā'ib(i).","translationEn":"","translationId":"yang keluar dari antara tulang sulbi (punggung) dan tulang dada.","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":5939,"textArabic":"اِنَّهٗ عَلٰى رَجْعِهٖ لَقَادِرٌۗ ","textLatin":"Innahū ‘alā raj‘ihī laqādir(un).","translationEn":"","translationId":"Sesungguhnya Dia (Allah) benar-benar kuasa untuk mengembalikannya (hidup setelah mati)","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":5940,"textArabic":"يَوْمَ تُبْلَى السَّرَاۤىِٕرُۙ ","textLatin":"Yauma tublas-sarā'ir(u).","translationEn":"","translationId":"pada hari ditampakkan segala rahasia.","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":5941,"textArabic":"فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍۗ ","textLatin":"Famā lahū min quwwatiw wa lā nāṣir(in).","translationEn":"","translationId":"Maka, baginya (manusia) tidak ada lagi kekuatan dan tidak (pula) ada penolong.","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":5942,"textArabic":"وَالسَّمَاۤءِ ذَاتِ الرَّجْعِۙ ","textLatin":"Was-samā'i żātir-raj‘(i).","translationEn":"","translationId":"Demi langit yang mengandung hujan","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":5943,"textArabic":"وَالْاَرْضِ ذَاتِ الصَّدْعِۙ ","textLatin":"Wal-arḍi żātiṣ-ṣad‘(i).","translationEn":"","translationId":"dan bumi yang memiliki rekahan (tempat tumbuhnya pepohonan),","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":5944,"textArabic":"اِنَّهٗ لَقَوْلٌ فَصْلٌۙ ","textLatin":"Innahū laqaulun faṣl(un).","translationEn":"","translationId":"sesungguhnya (Al-Qur’an) itu benar-benar firman pemisah (antara yang hak dan yang batil)","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":5945,"textArabic":"وَّمَا هُوَ بِالْهَزْلِۗ ","textLatin":"Wa mā huwa bil-hazl(i).","translationEn":"","translationId":"dan ia (Al-Qur’an) sama sekali bukan perkataan senda gurau.","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":5946,"textArabic":"اِنَّهُمْ يَكِيْدُوْنَ كَيْدًاۙ ","textLatin":"Innahum yakīdūna kaidā(n).","translationEn":"","translationId":"Sesungguhnya mereka (orang kafir) melakukan tipu daya.","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":5947,"textArabic":"وَّاَكِيْدُ كَيْدًاۖ ","textLatin":"Wa akīdu kaidā(n).","translationEn":"","translationId":"Aku pun membalasnya dengan tipu daya.","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":5948,"textArabic":"فَمَهِّلِ الْكٰفِرِيْنَ اَمْهِلْهُمْ رُوَيْدًا ࣖ ","textLatin":"Fa mahhilil-kāfirīna amhilhum ruwaidā(n).","translationEn":"","translationId":"Maka, tangguhkanlah orang-orang kafir itu. Biarkanlah mereka sejenak (bersenang-senang).","tafsirId":"","juz":30}]