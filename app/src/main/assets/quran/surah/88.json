[{"numberInSurah":1,"numberInQuran":5968,"textArabic":"هَلْ اَتٰىكَ حَدِيْثُ الْغَاشِيَةِۗ","textLatin":"Hal atāka ḥadīṡul-gāsyiyah(ti).","translationEn":"","translationId":"Sudahkah sampai kepadamu berita tentang al-Gāsyiyah (hari Kiamat yang menutupi kesadaran manusia dengan kedahsyatannya)?","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":5969,"textArabic":"وُجُوْهٌ يَّوْمَىِٕذٍ خَاشِعَةٌ  ۙ","textLatin":"Wujūhuy yauma'iżin khāsyi‘ah(tun).","translationEn":"","translationId":"Pada hari itu banyak wajah yang tertunduk hina","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":5970,"textArabic":"عَامِلَةٌ نَّاصِبَةٌ  ۙ","textLatin":"‘Amilatun nāṣibah(tun).","translationEn":"","translationId":"(karena) berusaha keras (menghindari azab neraka) lagi kepayahan (karena dibelenggu).","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":5971,"textArabic":"تَصْلٰى نَارًا حَامِيَةً  ۙ","textLatin":"Taṣlā nāran ḥāmiyah(tan).","translationEn":"","translationId":"Mereka memasuki api (neraka) yang sangat panas.","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":5972,"textArabic":"تُسْقٰى مِنْ عَيْنٍ اٰنِيَةٍ ۗ","textLatin":"Tusqā min ‘ainin āniyah(tin).","translationEn":"","translationId":"(Mereka) diberi minum dari sumber mata air yang sangat panas.","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":5973,"textArabic":"لَيْسَ لَهُمْ طَعَامٌ اِلَّا مِنْ ضَرِيْعٍۙ","textLatin":"Laisa lahum ṭa‘āmun illā min ḍarī‘(in).","translationEn":"","translationId":"Tidak ada makanan bagi mereka selain dari pohon yang berduri,","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":5974,"textArabic":"لَّا يُسْمِنُ وَلَا يُغْنِيْ مِنْ جُوْعٍۗ","textLatin":"Lā yusminu wa lā yugnī min jū‘(in).","translationEn":"","translationId":"yang tidak menggemukkan dan tidak pula menghilangkan lapar.","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":5975,"textArabic":"وُجُوْهٌ يَّوْمَىِٕذٍ نَّاعِمَةٌ  ۙ","textLatin":"Wujūhuy yauma'iżin nā‘imah(tun).","translationEn":"","translationId":"Pada hari itu banyak (pula) wajah yang berseri-seri,","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":5976,"textArabic":"لِّسَعْيِهَا رَاضِيَةٌ  ۙ ","textLatin":"Lisa‘yihā rāḍiyah(tun).","translationEn":"","translationId":"merasa puas karena usahanya.","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":5977,"textArabic":"فِيْ جَنَّةٍ عَالِيَةٍۙ","textLatin":"Fī jannatin ‘āliyah(tin).","translationEn":"","translationId":"(Mereka) dalam surga yang tinggi.","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":5978,"textArabic":"لَّا تَسْمَعُ فِيْهَا لَاغِيَةً ۗ","textLatin":"Lā tasama‘u fīhā lāgiyah(tan).","translationEn":"","translationId":"Di sana kamu tidak mendengar (perkataan) yang tidak berguna.","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":5979,"textArabic":"فِيْهَا عَيْنٌ جَارِيَةٌ  ۘ","textLatin":"Fīhā ‘ainun jāriyah(tun).","translationEn":"","translationId":"Di sana ada mata air yang mengalir.","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":5980,"textArabic":"فِيْهَا سُرُرٌ مَّرْفُوْعَةٌ  ۙ","textLatin":"Fīhā sururum marfū‘ah(tun).","translationEn":"","translationId":"Di sana ada (pula) dipan-dipan yang ditinggikan,","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":5981,"textArabic":"وَّاَكْوَابٌ مَّوْضُوْعَةٌ  ۙ","textLatin":"Wa akwābum mauḍū‘ah(tun).","translationEn":"","translationId":"gelas-gelas yang tersedia (di dekatnya),","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":5982,"textArabic":"وَّنَمَارِقُ مَصْفُوْفَةٌ  ۙ ","textLatin":"Wa namāriqu maṣfūfah(tun).","translationEn":"","translationId":"bantal-bantal sandaran yang tersusun,","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":5983,"textArabic":"وَّزَرَابِيُّ مَبْثُوْثَةٌ  ۗ","textLatin":"Wa zarābiyyu mabṡūṡah(tun).","translationEn":"","translationId":"dan permadani-permadani yang terhampar.","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":5984,"textArabic":"اَفَلَا يَنْظُرُوْنَ اِلَى الْاِبِلِ كَيْفَ خُلِقَتْۗ","textLatin":"Afalā yanẓurūna ilal-ibili kaifa khuliqat.","translationEn":"","translationId":"Tidakkah mereka memperhatikan unta, bagaimana ia diciptakan?","tafsirId":"","juz":30},{"numberInSurah":18,"numberInQuran":5985,"textArabic":"وَاِلَى السَّمَاۤءِ كَيْفَ رُفِعَتْۗ","textLatin":"Wa ilas-samā'i kaifa rufi‘at.","translationEn":"","translationId":"Bagaimana langit ditinggikan?","tafsirId":"","juz":30},{"numberInSurah":19,"numberInQuran":5986,"textArabic":"وَاِلَى الْجِبَالِ كَيْفَ نُصِبَتْۗ","textLatin":"Wa ilal-jibāli kaifa nuṣibat.","translationEn":"","translationId":"Bagaimana gunung-gunung ditegakkan?","tafsirId":"","juz":30},{"numberInSurah":20,"numberInQuran":5987,"textArabic":"وَاِلَى الْاَرْضِ كَيْفَ سُطِحَتْۗ ","textLatin":"Wa ilal-arḍi kaifa suṭiḥat.","translationEn":"","translationId":"Bagaimana pula bumi dihamparkan?","tafsirId":"","juz":30},{"numberInSurah":21,"numberInQuran":5988,"textArabic":"فَذَكِّرْۗ اِنَّمَآ اَنْتَ مُذَكِّرٌۙ","textLatin":"Fa żakkir, innamā anta mużakkir(un).","translationEn":"","translationId":"Maka, berilah peringatan karena sesungguhnya engkau (Nabi Muhammad) hanyalah pemberi peringatan.","tafsirId":"","juz":30},{"numberInSurah":22,"numberInQuran":5989,"textArabic":"لَّسْتَ عَلَيْهِمْ بِمُصَيْطِرٍۙ","textLatin":"Lasta ‘alaihim bimusaiṭir(in).","translationEn":"","translationId":"Engkau bukanlah orang yang berkuasa atas mereka.","tafsirId":"","juz":30},{"numberInSurah":23,"numberInQuran":5990,"textArabic":"اِلَّا مَنْ تَوَلّٰى وَكَفَرَۙ","textLatin":"Illā man tawallā wa kafar(a).","translationEn":"","translationId":"Akan tetapi, orang yang berpaling dan kufur,","tafsirId":"","juz":30},{"numberInSurah":24,"numberInQuran":5991,"textArabic":"فَيُعَذِّبُهُ اللّٰهُ الْعَذَابَ الْاَكْبَرَۗ","textLatin":"Fa yu‘ażżibuhullāhul-‘ażābal-akbar(a).","translationEn":"","translationId":"Allah akan mengazabnya dengan azab yang paling besar.","tafsirId":"","juz":30},{"numberInSurah":25,"numberInQuran":5992,"textArabic":"اِنَّ اِلَيْنَآ اِيَابَهُمْ","textLatin":"Inna ilainā iyābahum.","translationEn":"","translationId":"Sesungguhnya kepada Kamilah mereka kembali.","tafsirId":"","juz":30},{"numberInSurah":26,"numberInQuran":5993,"textArabic":"ثُمَّ اِنَّ عَلَيْنَا حِسَابَهُمْ ࣖ","textLatin":"Ṡumma inna ‘alainā ḥisābahum.","translationEn":"","translationId":"Kemudian, sesungguhnya Kamilah yang berhak melakukan hisab (perhitungan) atas mereka.","tafsirId":"","juz":30}]