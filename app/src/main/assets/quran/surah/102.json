[{"numberInSurah":1,"numberInQuran":6169,"textArabic":"اَلْهٰىكُمُ التَّكَاثُرُۙ","textLatin":"Alhākumut-takāṡur(u).","translationEn":"","translationId":"Berbangga-bangga dalam memperbanyak (dunia) telah melalaikanmu","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6170,"textArabic":"حَتّٰى زُرْتُمُ الْمَقَابِرَۗ","textLatin":"Ḥattā zurtumul-maqābir(a).","translationEn":"","translationId":"sampai kamu masuk ke dalam kubur.","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6171,"textArabic":"كَلَّا سَوْفَ تَعْلَمُوْنَۙ","textLatin":"Kallā saufa ta‘lamūn(a).","translationEn":"","translationId":"Sekali-kali tidak! Kelak kamu akan mengetahui (akibat perbuatanmu itu).","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6172,"textArabic":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُوْنَ ","textLatin":"Ṡumma kallā saufa ta‘lamūn(a).","translationEn":"","translationId":"Sekali-kali tidak (jangan melakukan itu)! Kelak kamu akan mengetahui (akibatnya).","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":6173,"textArabic":"كَلَّا لَوْ تَعْلَمُوْنَ عِلْمَ الْيَقِيْنِۗ","textLatin":"Kallā lau ta‘lamūna ‘ilmal-yaqīn(i).","translationEn":"","translationId":"Sekali-kali tidak (jangan melakukan itu)! Sekiranya kamu mengetahui dengan pasti, (niscaya kamu tidak akan melakukannya).","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":6174,"textArabic":"لَتَرَوُنَّ الْجَحِيْمَۙ","textLatin":"Latarawunnal-jaḥīm(a).","translationEn":"","translationId":"Pasti kamu benar-benar akan melihat (neraka) Jahim.","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":6175,"textArabic":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِيْنِۙ","textLatin":"Ṡumma latarawunnahā ‘ainal-yaqīn(i).","translationEn":"","translationId":"Kemudian, kamu pasti benar-benar akan melihatnya dengan ainulyakin.","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":6176,"textArabic":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَىِٕذٍ عَنِ النَّعِيْمِ ࣖ","textLatin":"Ṡumma latus'alunna yauma'iżin ‘anin-na‘īm(i).","translationEn":"","translationId":"Kemudian, kamu pasti benar-benar akan ditanya pada hari itu tentang kenikmatan (yang megah di dunia itu).","tafsirId":"","juz":30}]