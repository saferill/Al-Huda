[{"numberInSurah":1,"numberInQuran":5830,"textArabic":"اِذَا السَّمَاۤءُ انْفَطَرَتْۙ","textLatin":"Iżas-samā'unfaṭarat.","translationEn":"","translationId":"Apabila langit terbelah,","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":5831,"textArabic":"وَاِذَا الْكَوَاكِبُ انْتَثَرَتْۙ","textLatin":"Wa iżal-kawākibuntaṡarat.","translationEn":"","translationId":"apabila bintang-bintang jatuh berserakan,","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":5832,"textArabic":"وَاِذَا الْبِحَارُ فُجِّرَتْۙ","textLatin":"Wa iżal-biḥāru fujjirat.","translationEn":"","translationId":"apabila lautan diluapkan,","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":5833,"textArabic":"وَاِذَا الْقُبُوْرُ بُعْثِرَتْۙ","textLatin":"Wa iżal-qubūru bu‘ṡirat.","translationEn":"","translationId":"dan apabila kuburan-kuburan dibongkar,","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":5834,"textArabic":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَاَخَّرَتْۗ","textLatin":"‘Alimat nafsum mā qaddamat wa akhkharat.","translationEn":"","translationId":"setiap jiwa akan mengetahui apa yang telah dikerjakan dan yang dilalaikan(-nya).","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":5835,"textArabic":"يٰٓاَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيْمِۙ","textLatin":"Yā ayyuhal-insānu mā garraka birabbikal-karīm(i).","translationEn":"","translationId":"Wahai manusia, apakah yang telah memperdayakanmu (berbuat durhaka) terhadap Tuhanmu Yang Maha Mulia,","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":5836,"textArabic":"الَّذِيْ خَلَقَكَ فَسَوّٰىكَ فَعَدَلَكَۙ","textLatin":"Allażī khalaqaka fa sawwāka fa ‘adalak(a).","translationEn":"","translationId":"yang telah menciptakanmu lalu menyempurnakan kejadianmu dan menjadikan (susunan tubuh)-mu seimbang?","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":5837,"textArabic":"فِيْٓ اَيِّ صُوْرَةٍ مَّا شَاۤءَ رَكَّبَكَۗ","textLatin":"Fī ayyi ṣūratim mā syā'a rakkabak(a).","translationEn":"","translationId":"Dalam bentuk apa saja yang dikehendaki, Dia menyusun (tubuh)-mu.","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":5838,"textArabic":"كَلَّا بَلْ تُكَذِّبُوْنَ بِالدِّيْنِۙ","textLatin":"Kallā bal tukażżibūna bid-dīn(i).","translationEn":"","translationId":"Jangan sekali-kali begitu! Bahkan, kamu mendustakan hari Pembalasan.","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":5839,"textArabic":"وَاِنَّ عَلَيْكُمْ لَحٰفِظِيْنَۙ","textLatin":"Wa inna ‘alaikum laḥāfiẓīn(a).","translationEn":"","translationId":"Sesungguhnya bagi kamu ada (malaikat-malaikat) pengawas","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":5840,"textArabic":"كِرَامًا كٰتِبِيْنَۙ","textLatin":"Kirāman kātibīn(a).","translationEn":"","translationId":"yang mulia (di sisi Allah) dan mencatat (amal perbuatanmu).","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":5841,"textArabic":"يَعْلَمُوْنَ مَا تَفْعَلُوْنَ","textLatin":"Ya‘lamūna mā taf‘alūn(a).","translationEn":"","translationId":"Mereka mengetahui apa yang kamu kerjakan.","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":5842,"textArabic":"اِنَّ الْاَبْرَارَ لَفِيْ نَعِيْمٍۙ","textLatin":"Innal-abrāra lafī na‘īm(in).","translationEn":"","translationId":"Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan.","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":5843,"textArabic":"وَّاِنَّ الْفُجَّارَ لَفِيْ جَحِيْمٍ","textLatin":"Wa innal-fujjāra lafī jaḥīm(in).","translationEn":"","translationId":"Sesungguhnya orang-orang yang durhaka benar-benar berada dalam (neraka) Jahim.","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":5844,"textArabic":"يَصْلَوْنَهَا يَوْمَ الدِّيْنِ","textLatin":"Yaṣlaunahā yaumad-dīn(i).","translationEn":"","translationId":"Mereka memasukinya pada hari Pembalasan.","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":5845,"textArabic":"وَمَا هُمْ عَنْهَا بِغَاۤىِٕبِيْنَۗ","textLatin":"Wa mā hum ‘anhā bigā'ibīn(a).","translationEn":"","translationId":"Mereka tidak mungkin keluar dari (neraka) itu.","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":5846,"textArabic":"وَمَآ اَدْرٰىكَ مَا يَوْمُ الدِّيْنِۙ","textLatin":"Wa mā adrāka mā yaumud-dīn(i).","translationEn":"","translationId":"Tahukah engkau apakah hari Pembalasan itu?","tafsirId":"","juz":30},{"numberInSurah":18,"numberInQuran":5847,"textArabic":"ثُمَّ مَآ اَدْرٰىكَ مَا يَوْمُ الدِّيْنِۗ","textLatin":"Ṡumma mā adrāka mā yaumud-dīn(i).","translationEn":"","translationId":"Kemudian, tahukah engkau apakah hari Pembalasan itu?","tafsirId":"","juz":30},{"numberInSurah":19,"numberInQuran":5848,"textArabic":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۗوَالْاَمْرُ يَوْمَىِٕذٍ لِّلّٰهِ ࣖ","textLatin":"Yauma lā tamliku nafsul linafsin syai'ā(n), wal-amru yauma'iżil lillāh(i).","translationEn":"","translationId":"(Itulah) hari (ketika) seseorang tidak berdaya (menolong) orang lain sedikit pun. Segala urusan pada hari itu adalah milik Allah.","tafsirId":"","juz":30}]