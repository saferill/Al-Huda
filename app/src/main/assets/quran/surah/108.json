[{"numberInSurah":1,"numberInQuran":6205,"textArabic":"اِنَّآ اَعْطَيْنٰكَ الْكَوْثَرَۗ","textLatin":"Innā a‘ṭainākal-kauṡar(a).","translationEn":"","translationId":"Sesungguhnya Kami telah memberimu (Nabi Muhammad) nikmat yang banyak.","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6206,"textArabic":"فَصَلِّ لِرَبِّكَ وَانْحَرْۗ","textLatin":"Faṣalli lirabbika wanḥar.","translationEn":"","translationId":"Maka, laksanakanlah salat karena Tuhanmu dan berkurbanlah!","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6207,"textArabic":"اِنَّ شَانِئَكَ هُوَ الْاَبْتَرُ ࣖ","textLatin":"Inna syāni'aka huwal-abtar(u).","translationEn":"","translationId":"Sesungguhnya orang yang membencimu, dialah yang terputus (dari rahmat Allah).","tafsirId":"","juz":30}]