[{"numberInSurah":1,"numberInQuran":6222,"textArabic":"قُلْ هُوَ اللّٰهُ اَحَدٌۚ","textLatin":"Qul huwallāhu aḥad(un).","translationEn":"","translationId":"Katakanlah (Nabi Muhammad), “Dialah Allah Yang Maha Esa.","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6223,"textArabic":"اَللّٰهُ الصَّمَدُۚ","textLatin":"Allāhuṣ-ṣamad(u).","translationEn":"","translationId":"Allah tempat meminta segala sesuatu.","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6224,"textArabic":"لَمْ يَلِدْ وَلَمْ يُوْلَدْۙ","textLatin":"Lam yalid wa lam yūlad.","translationEn":"","translationId":"Dia tidak beranak dan tidak pula diperanakkan","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6225,"textArabic":"وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ࣖ","textLatin":"Wa lam yakul lahū kufuwan aḥad(un).","translationEn":"","translationId":"serta tidak ada sesuatu pun yang setara dengan-Nya.”","tafsirId":"","juz":30}]