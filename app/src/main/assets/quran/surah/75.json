[{"numberInSurah":1,"numberInQuran":5552,"textArabic":"لَآ اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ","textLatin":"Lā uqsimu biyaumil-qiyāmah(ti).","translationEn":"","translationId":"Aku bersumpah demi hari Kiamat.","tafsirId":"","juz":29},{"numberInSurah":2,"numberInQuran":5553,"textArabic":"وَلَآ اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ ","textLatin":"Wa lā uqsimu bin nafsil-lawwāmah(ti).","translationEn":"","translationId":"Aku bersumpah demi jiwa yang sangat menyesali (dirinya sendiri).","tafsirId":"","juz":29},{"numberInSurah":3,"numberInQuran":5554,"textArabic":"اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَّجْمَعَ عِظَامَهٗ ۗ","textLatin":"Ayaḥsabul-insānu allan najma‘a ‘iẓāmah(ū).","translationEn":"","translationId":"Apakah manusia mengira bahwa Kami tidak akan mengumpulkan (kembali) tulang-belulangnya?","tafsirId":"","juz":29},{"numberInSurah":4,"numberInQuran":5555,"textArabic":"بَلٰى قٰدِرِيْنَ عَلٰٓى اَنْ نُّسَوِّيَ بَنَانَهٗ ","textLatin":"Balā qādirīna ‘alā an nusawwiya banānah(ū).","translationEn":"","translationId":"Tentu, (bahkan) Kami mampu menyusun (kembali) jari-jemarinya dengan sempurna.","tafsirId":"","juz":29},{"numberInSurah":5,"numberInQuran":5556,"textArabic":"بَلْ يُرِيْدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهٗۚ","textLatin":"Bal yurīdul-insānu liyafjura amāmah(ū).","translationEn":"","translationId":"Akan tetapi, manusia hendak berbuat maksiat terus-menerus.","tafsirId":"","juz":29},{"numberInSurah":6,"numberInQuran":5557,"textArabic":"يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۗ","textLatin":"Yas'alu ayyāna yaumul-qiyāmah(ti).","translationEn":"","translationId":"Dia bertanya, “Kapankah hari Kiamat itu?”","tafsirId":"","juz":29},{"numberInSurah":7,"numberInQuran":5558,"textArabic":"فَاِذَا بَرِقَ الْبَصَرُۙ","textLatin":"Fa iżā bariqal-baṣar(u).","translationEn":"","translationId":"Apabila mata terbelalak (ketakutan),","tafsirId":"","juz":29},{"numberInSurah":8,"numberInQuran":5559,"textArabic":"وَخَسَفَ الْقَمَرُۙ","textLatin":"Wa khasafal-qamar(u).","translationEn":"","translationId":"bulan pun telah hilang cahayanya,","tafsirId":"","juz":29},{"numberInSurah":9,"numberInQuran":5560,"textArabic":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ","textLatin":"Wa jumi‘asy-syamsu wal-qamar(u).","translationEn":"","translationId":"serta matahari dan bulan dikumpulkan,","tafsirId":"","juz":29},{"numberInSurah":10,"numberInQuran":5561,"textArabic":"يَقُوْلُ الْاِنْسَانُ يَوْمَىِٕذٍ اَيْنَ الْمَفَرُّۚ","textLatin":"Yaqūlul-insānu yauma'iżin ainal-mafarr(u).","translationEn":"","translationId":"pada hari itu manusia berkata, “Ke mana tempat lari?”","tafsirId":"","juz":29},{"numberInSurah":11,"numberInQuran":5562,"textArabic":"كَلَّا لَا وَزَرَۗ","textLatin":"Kallā lā wazar(a).","translationEn":"","translationId":"Sekali-kali tidak! Tidak ada tempat berlindung.","tafsirId":"","juz":29},{"numberInSurah":12,"numberInQuran":5563,"textArabic":"اِلٰى رَبِّكَ يَوْمَىِٕذِ ِۨالْمُسْتَقَرُّۗ","textLatin":"Ilā rabbika yauma'iżinil-mustaqarr(u).","translationEn":"","translationId":"(Hanya) kepada Tuhanmu tempat kembali pada hari itu.","tafsirId":"","juz":29},{"numberInSurah":13,"numberInQuran":5564,"textArabic":"يُنَبَّؤُا الْاِنْسَانُ يَوْمَىِٕذٍۢ بِمَا قَدَّمَ وَاَخَّرَۗ","textLatin":"Yunabba'ul-insānu yauma'iżim bimā qaddama wa akhkhar(a).","translationEn":"","translationId":"Pada hari itu diberitakan kepada manusia apa yang telah dia kerjakan dan apa yang telah dia lalaikan.","tafsirId":"","juz":29},{"numberInSurah":14,"numberInQuran":5565,"textArabic":"بَلِ الْاِنْسَانُ عَلٰى نَفْسِهٖ بَصِيْرَةٌۙ","textLatin":"Balil-insānu ‘alā nafsihī baṣīrah(tun).","translationEn":"","translationId":"Bahkan, manusia menjadi saksi atas dirinya sendiri","tafsirId":"","juz":29},{"numberInSurah":15,"numberInQuran":5566,"textArabic":"وَّلَوْ اَلْقٰى مَعَاذِيْرَهٗۗ","textLatin":"Wa lau alqā ma‘āżīrah(ū).","translationEn":"","translationId":"walaupun dia mengemukakan alasan-alasan(-nya).","tafsirId":"","juz":29},{"numberInSurah":16,"numberInQuran":5567,"textArabic":"لَا تُحَرِّكْ بِهٖ لِسَانَكَ لِتَعْجَلَ بِهٖۗ","textLatin":"Lā tuḥarrik bihī lisānaka lita‘jala bih(ī).","translationEn":"","translationId":"Jangan engkau (Nabi Muhammad) gerakkan lidahmu (untuk membaca Al-Qur’an) karena hendak tergesa-gesa (menguasai)-nya.","tafsirId":"","juz":29},{"numberInSurah":17,"numberInQuran":5568,"textArabic":"اِنَّ عَلَيْنَا جَمْعَهٗ وَقُرْاٰنَهٗ ۚ","textLatin":"Inna ‘alainā jam‘ahū wa qur'ānah(ū).","translationEn":"","translationId":"Sesungguhnya tugas Kamilah untuk mengumpulkan (dalam hatimu) dan membacakannya.","tafsirId":"","juz":29},{"numberInSurah":18,"numberInQuran":5569,"textArabic":"فَاِذَا قَرَأْنٰهُ فَاتَّبِعْ قُرْاٰنَهٗ ۚ","textLatin":"Fa iżā qara'nāhu fattabi‘ qur'ānah(ū).","translationEn":"","translationId":"Maka, apabila Kami telah selesai membacakannya, ikutilah bacaannya itu.","tafsirId":"","juz":29},{"numberInSurah":19,"numberInQuran":5570,"textArabic":"ثُمَّ اِنَّ عَلَيْنَا بَيَانَهٗ ۗ","textLatin":"Ṡumma inna ‘alainā bayānah(ū).","translationEn":"","translationId":"Kemudian, sesungguhnya tugas Kami (pula)-lah (untuk) menjelaskannya.","tafsirId":"","juz":29},{"numberInSurah":20,"numberInQuran":5571,"textArabic":"كَلَّا بَلْ تُحِبُّوْنَ الْعَاجِلَةَۙ","textLatin":"Kallā bal tuḥibbūnal-‘ājilah(ta).","translationEn":"","translationId":"Sekali-kali tidak! Bahkan, kamu mencintai kehidupan dunia,","tafsirId":"","juz":29},{"numberInSurah":21,"numberInQuran":5572,"textArabic":"وَتَذَرُوْنَ الْاٰخِرَةَۗ","textLatin":"Wa tażarūnal-‘ākhirah(ta).","translationEn":"","translationId":"dan mengabaikan (kehidupan) akhirat.","tafsirId":"","juz":29},{"numberInSurah":22,"numberInQuran":5573,"textArabic":"وُجُوْهٌ يَّوْمَىِٕذٍ نَّاضِرَةٌۙ","textLatin":"Wujūhuy yauma'iżin nāḍirah(tun).","translationEn":"","translationId":"Wajah-wajah (orang mukmin) pada hari itu berseri-seri","tafsirId":"","juz":29},{"numberInSurah":23,"numberInQuran":5574,"textArabic":"اِلٰى رَبِّهَا نَاظِرَةٌ ۚ","textLatin":"Ilā rabbihā nāẓirah(tun).","translationEn":"","translationId":"(karena) memandang Tuhannya.","tafsirId":"","juz":29},{"numberInSurah":24,"numberInQuran":5575,"textArabic":"وَوُجُوْهٌ يَّوْمَىِٕذٍۢ بَاسِرَةٌۙ","textLatin":"Wa wujūhuy yauma'iżim bāsirah(tun).","translationEn":"","translationId":"Wajah-wajah (orang kafir) pada hari itu muram","tafsirId":"","juz":29},{"numberInSurah":25,"numberInQuran":5576,"textArabic":"تَظُنُّ اَنْ يُّفْعَلَ بِهَا فَاقِرَةٌ ۗ","textLatin":"Taẓunnu ay yuf‘ala bihā fāqirah(tun).","translationEn":"","translationId":"(karena) mereka yakin akan ditimpakan kepadanya malapetaka yang sangat dahsyat.","tafsirId":"","juz":29},{"numberInSurah":26,"numberInQuran":5577,"textArabic":"كَلَّآ اِذَا بَلَغَتِ التَّرَاقِيَۙ","textLatin":"Kallā iżā balagatit-tarāqiy(a).","translationEn":"","translationId":"Sekali-kali tidak! Apabila (nyawa) telah sampai di kerongkongan,","tafsirId":"","juz":29},{"numberInSurah":27,"numberInQuran":5578,"textArabic":"وَقِيْلَ مَنْ ۜرَاقٍۙ","textLatin":"Wa qīla man…rāq(in).","translationEn":"","translationId":"dan dikatakan (kepadanya), “Siapa yang (dapat) menyembuhkan?”","tafsirId":"","juz":29},{"numberInSurah":28,"numberInQuran":5579,"textArabic":"وَّظَنَّ اَنَّهُ الْفِرَاقُۙ","textLatin":"Wa ẓanna annahul-firāq(u).","translationEn":"","translationId":"Dia pun yakin bahwa itulah waktu perpisahan (dengan dunia),","tafsirId":"","juz":29},{"numberInSurah":29,"numberInQuran":5580,"textArabic":"وَالْتَفَّتِ السَّاقُ بِالسَّاقِۙ","textLatin":"Waltaffatis-sāqu bis-sāq(i).","translationEn":"","translationId":"dan bertautlah betis (kiri) dengan betis (kanan).","tafsirId":"","juz":29},{"numberInSurah":30,"numberInQuran":5581,"textArabic":"اِلٰى رَبِّكَ يَوْمَىِٕذِ ِۨالْمَسَاقُ ۗ ࣖ","textLatin":"Ilā rabbika yauma'iżinil-masāq(u).","translationEn":"","translationId":"Kepada Tuhanmulah pada hari itu (manusia) digiring.","tafsirId":"","juz":29},{"numberInSurah":31,"numberInQuran":5582,"textArabic":"فَلَا صَدَّقَ وَلَا صَلّٰىۙ","textLatin":"Falā ṣaddaqa wa lā ṣallā.","translationEn":"","translationId":"Dia tidak membenarkan (Al-Qur’an dan Rasul) dan tidak melaksanakan salat.","tafsirId":"","juz":29},{"numberInSurah":32,"numberInQuran":5583,"textArabic":"وَلٰكِنْ كَذَّبَ وَتَوَلّٰىۙ","textLatin":"Wa lākin każżaba wa tawallā.","translationEn":"","translationId":"Akan tetapi, dia mendustakan (Al-Qur’an) dan berpaling (dari kebenaran).","tafsirId":"","juz":29},{"numberInSurah":33,"numberInQuran":5584,"textArabic":"ثُمَّ ذَهَبَ اِلٰٓى اَهْلِهٖ يَتَمَطّٰىۗ","textLatin":"Ṡumma żahaba ilā ahlihī yatamaṭṭā.","translationEn":"","translationId":"Kemudian, dia pergi kepada keluarganya dengan menyombongkan diri.","tafsirId":"","juz":29},{"numberInSurah":34,"numberInQuran":5585,"textArabic":"اَوْلٰى لَكَ فَاَوْلٰىۙ","textLatin":"Aulā laka fa'aulā.","translationEn":"","translationId":"Celakalah kamu! Maka, celakalah!","tafsirId":"","juz":29},{"numberInSurah":35,"numberInQuran":5586,"textArabic":"ثُمَّ اَوْلٰى لَكَ فَاَوْلٰىۗ","textLatin":"Ṡumma aulā laka fa'aulā.","translationEn":"","translationId":"Kemudian, celakalah kamu! Maka, celakalah!","tafsirId":"","juz":29},{"numberInSurah":36,"numberInQuran":5587,"textArabic":"اَيَحْسَبُ الْاِنْسَانُ اَنْ يُّتْرَكَ سُدًىۗ","textLatin":"Ayaḥsabul-insānu ay yutraka sudā(n).","translationEn":"","translationId":"Apakah manusia mengira akan dibiarkan begitu saja (tanpa pertanggungjawaban)?","tafsirId":"","juz":29},{"numberInSurah":37,"numberInQuran":5588,"textArabic":"اَلَمْ يَكُ نُطْفَةً مِّنْ مَّنِيٍّ يُّمْنٰى ","textLatin":"Alam yaku nuṭfatam mim maniyyiy yumnā.","translationEn":"","translationId":"Bukankah dia dahulu setetes mani yang ditumpahkan (ke dalam rahim)?","tafsirId":"","juz":29},{"numberInSurah":38,"numberInQuran":5589,"textArabic":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰىۙ","textLatin":"Ṡumma kāna ‘alaqatan fa khalaqa fa sawwā.","translationEn":"","translationId":"Kemudian, (mani itu) menjadi sesuatu yang melekat, lalu Dia menciptakan dan menyempurnakannya.","tafsirId":"","juz":29},{"numberInSurah":39,"numberInQuran":5590,"textArabic":"فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْاُنْثٰىۗ","textLatin":"Fa ja‘ala minhuz-zaujainiż-żakara wal-unṡā.","translationEn":"","translationId":"Lalu, Dia menjadikan darinya sepasang laki-laki dan perempuan.","tafsirId":"","juz":29},{"numberInSurah":40,"numberInQuran":5591,"textArabic":"اَلَيْسَ ذٰلِكَ بِقٰدِرٍ عَلٰٓى اَنْ يُّحْيِ َۧ الْمَوْتٰى ࣖ","textLatin":"Alaisa żālika  biqādirin ‘alā ay yuḥyiyal-mautā.","translationEn":"","translationId":"Bukankah (Allah) itu kuasa (pula) menghidupkan orang mati?","tafsirId":"","juz":29}]