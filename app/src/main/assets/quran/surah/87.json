[{"numberInSurah":1,"numberInQuran":5949,"textArabic":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَىۙ ","textLatin":"Sabbiḥisma rabbikal-a‘lā.","translationEn":"","translationId":"Sucikanlah nama Tuhanmu Yang Maha Tinggi,","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":5950,"textArabic":"الَّذِيْ خَلَقَ فَسَوّٰىۖ ","textLatin":"Allażī khalaqa fasawwā.","translationEn":"","translationId":"yang menciptakan, lalu menyempurnakan (ciptaan-Nya),","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":5951,"textArabic":"وَالَّذِيْ قَدَّرَ فَهَدٰىۖ ","textLatin":"Wal-lażī qaddara fahadā.","translationEn":"","translationId":"yang menentukan kadar (masing-masing) dan memberi petunjuk,","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":5952,"textArabic":"وَالَّذِيْٓ اَخْرَجَ الْمَرْعٰىۖ ","textLatin":"Wal-lażī akhrajal-mar‘ā.","translationEn":"","translationId":"dan yang menumbuhkan (rerumputan) padang gembala,","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":5953,"textArabic":"فَجَعَلَهٗ غُثَاۤءً اَحْوٰىۖ ","textLatin":"Fa ja‘alahū guṡā'an aḥwā.","translationEn":"","translationId":"lalu menjadikannya kering kehitam-hitaman.","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":5954,"textArabic":"سَنُقْرِئُكَ فَلَا تَنْسٰىٓ  ۖ ","textLatin":"Sanuqri'uka falā tansā.","translationEn":"","translationId":"Kami akan membacakan (Al-Qur’an) kepadamu (Nabi Muhammad) sehingga engkau tidak akan lupa,","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":5955,"textArabic":"اِلَّا مَا شَاۤءَ اللّٰهُ ۗاِنَّهٗ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۗ ","textLatin":"Illā mā syā'allāh(u), innahū ya‘lamul-jahra wa mā yakhfā.","translationEn":"","translationId":"kecuali jika Allah menghendaki. Sesungguhnya Dia mengetahui yang terang dan yang tersembunyi.","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":5956,"textArabic":"وَنُيَسِّرُكَ لِلْيُسْرٰىۖ ","textLatin":"Wa nuyassiruka lil-yusrā.","translationEn":"","translationId":"Kami akan melapangkan bagimu jalan kemudahan (dalam segala urusan).","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":5957,"textArabic":"فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰىۗ ","textLatin":"Fa żakkir in nafa‘atiż-żikrā.","translationEn":"","translationId":"Maka, sampaikanlah peringatan jika peringatan itu bermanfaat.","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":5958,"textArabic":"سَيَذَّكَّرُ مَنْ يَّخْشٰىۙ ","textLatin":"Sayażżakkaru may yakhsyā.","translationEn":"","translationId":"Orang yang takut (kepada Allah) akan mengambil pelajaran,","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":5959,"textArabic":"وَيَتَجَنَّبُهَا الْاَشْقَىۙ ","textLatin":"Wa yatajannabuhal-asyqā.","translationEn":"","translationId":"sedangkan orang-orang yang celaka (kafir) akan menjauhinya,","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":5960,"textArabic":"الَّذِيْ يَصْلَى النَّارَ الْكُبْرٰىۚ ","textLatin":"Allażī yaṣlan-nāral-kubrā.","translationEn":"","translationId":"(yaitu) orang yang akan memasuki api (neraka) yang besar.","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":5961,"textArabic":"ثُمَّ لَا يَمُوْتُ فِيْهَا وَلَا يَحْيٰىۗ ","textLatin":"Ṡumma lā yamūtu fīhā wa lā yaḥyā.","translationEn":"","translationId":"Selanjutnya, dia tidak mati dan tidak (pula) hidup di sana.","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":5962,"textArabic":"قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ ","textLatin":"Qad aflaḥa man tazakkā.","translationEn":"","translationId":"Sungguh, beruntung orang yang menyucikan diri (dari kekafiran)","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":5963,"textArabic":"وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰىۗ ","textLatin":"Wa żakarasma rabbihī fa ṣallā.","translationEn":"","translationId":"dan mengingat nama Tuhannya, lalu dia salat.","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":5964,"textArabic":"بَلْ تُؤْثِرُوْنَ الْحَيٰوةَ الدُّنْيَاۖ ","textLatin":"Bal tu'ṡirūnal-ḥayātad-dun-yā.","translationEn":"","translationId":"Adapun kamu (orang-orang kafir) mengutamakan kehidupan dunia,","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":5965,"textArabic":"وَالْاٰخِرَةُ خَيْرٌ وَّاَبْقٰىۗ ","textLatin":"Wal-ākhiratu khairuw wa abqā.","translationEn":"","translationId":"padahal kehidupan akhirat itu lebih baik dan lebih kekal.","tafsirId":"","juz":30},{"numberInSurah":18,"numberInQuran":5966,"textArabic":"اِنَّ هٰذَا لَفِى الصُّحُفِ الْاُوْلٰىۙ ","textLatin":"Inna hāżā lafiṣ-ṣuḥufil-ūlā.","translationEn":"","translationId":"Sesungguhnya (penjelasan) ini terdapat dalam suhuf (lembaran-lembaran) yang terdahulu,","tafsirId":"","juz":30},{"numberInSurah":19,"numberInQuran":5967,"textArabic":"صُحُفِ اِبْرٰهِيْمَ وَمُوْسٰى ࣖ ","textLatin":"Ṣuḥufi ibrāhīma wa mūsā.","translationEn":"","translationId":"(yaitu) suhuf (yang diturunkan kepada) Ibrahim dan Musa.","tafsirId":"","juz":30}]