[{"numberInSurah":1,"numberInQuran":6080,"textArabic":"وَالضُّحٰىۙ","textLatin":"Waḍ-ḍuḥā.","translationEn":"","translationId":"Demi waktu duha","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6081,"textArabic":"وَالَّيْلِ اِذَا سَجٰىۙ","textLatin":"Wal-laili iżā sajā.","translationEn":"","translationId":"dan demi waktu malam apabila telah sunyi,","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6082,"textArabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىۗ","textLatin":"Mā wadda‘aka rabbuka wa mā qalā.","translationEn":"","translationId":"Tuhanmu (Nabi Muhammad) tidak meninggalkan dan tidak (pula) membencimu.","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6083,"textArabic":"وَلَلْاٰخِرَةُ خَيْرٌ لَّكَ مِنَ الْاُوْلٰىۗ","textLatin":"Wa lal-ākhiratu khairul laka minal-ūlā.","translationEn":"","translationId":"Sungguh, akhirat itu lebih baik bagimu daripada yang permulaan (dunia).","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":6084,"textArabic":"وَلَسَوْفَ يُعْطِيْكَ رَبُّكَ فَتَرْضٰىۗ","textLatin":"Wa lasaufa yu‘ṭīka rabbuka fa tarḍā.","translationEn":"","translationId":"Sungguh, kelak (di akhirat nanti) Tuhanmu pasti memberikan karunia-Nya kepadamu sehingga engkau rida.","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":6085,"textArabic":"اَلَمْ يَجِدْكَ يَتِيْمًا فَاٰوٰىۖ","textLatin":"Alam yajidka yatīman fa āwā.","translationEn":"","translationId":"Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(-mu);","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":6086,"textArabic":"وَوَجَدَكَ ضَاۤلًّا فَهَدٰىۖ","textLatin":"Wa wajadaka ḍāllan fa hadā.","translationEn":"","translationId":"mendapatimu sebagai seorang yang tidak tahu (tentang syariat), lalu Dia memberimu petunjuk (wahyu);","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":6087,"textArabic":"وَوَجَدَكَ عَاۤىِٕلًا فَاَغْنٰىۗ","textLatin":"Wa wajadaka ‘ā'ilan fa agnā.","translationEn":"","translationId":"dan mendapatimu sebagai seorang yang fakir, lalu Dia memberimu kecukupan?","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":6088,"textArabic":"فَاَمَّا الْيَتِيْمَ فَلَا تَقْهَرْۗ","textLatin":"Fa ammal-yatīma falā taqhar.","translationEn":"","translationId":"Terhadap anak yatim, janganlah engkau berlaku sewenang-wenang.","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":6089,"textArabic":"وَاَمَّا السَّاۤىِٕلَ فَلَا تَنْهَرْ","textLatin":"Wa ammas-sā'ila falā tanhar.","translationEn":"","translationId":"Terhadap orang yang meminta-minta, janganlah engkau menghardik.","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":6090,"textArabic":"وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ࣖ","textLatin":"Wa ammā bini‘mati rabbika fa ḥaddiṡ.","translationEn":"","translationId":"Terhadap nikmat Tuhanmu, nyatakanlah (dengan bersyukur).","tafsirId":"","juz":30}]