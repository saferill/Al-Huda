[{"numberInSurah":1,"numberInQuran":6107,"textArabic":"اِقْرَأْ بِاسْمِ رَبِّكَ الَّذِيْ خَلَقَۚ","textLatin":"Iqra' bismi rabbikal-lażī khalaq(a).","translationEn":"","translationId":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan!","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6108,"textArabic":"خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ","textLatin":"Khalaqal-insāna min ‘alaq(in).","translationEn":"","translationId":"Dia menciptakan manusia dari segumpal darah.","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6109,"textArabic":"اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ","textLatin":"Iqra' wa rabbukal-akram(u).","translationEn":"","translationId":"Bacalah! Tuhanmulah Yang Maha Mulia,","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6110,"textArabic":"الَّذِيْ عَلَّمَ بِالْقَلَمِۙ","textLatin":"Allażī ‘allama bil-qalam(i).","translationEn":"","translationId":"yang mengajar (manusia) dengan pena.","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":6111,"textArabic":"عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۗ","textLatin":"‘Allamal-insāna mā lam ya‘lam.","translationEn":"","translationId":"Dia mengajarkan manusia apa yang tidak diketahuinya.","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":6112,"textArabic":"كَلَّآ اِنَّ الْاِنْسَانَ لَيَطْغٰىٓ ۙ","textLatin":"Kallā innal-insāna layaṭgā.","translationEn":"","translationId":"Sekali-kali tidak! Sesungguhnya manusia itu benar-benar melampaui batas","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":6113,"textArabic":"اَنْ رَّاٰهُ اسْتَغْنٰىۗ","textLatin":"Ar ra'āhustagnā.","translationEn":"","translationId":"ketika melihat dirinya serba berkecukupan.","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":6114,"textArabic":"اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۗ","textLatin":"Inna ilā rabbikar-ruj‘ā.","translationEn":"","translationId":"Sesungguhnya hanya kepada Tuhanmulah tempat kembali(-mu).","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":6115,"textArabic":"اَرَاَيْتَ الَّذِيْ يَنْهٰىۙ","textLatin":"Ara'aital-lażī yanhā.","translationEn":"","translationId":"Tahukah kamu tentang orang yang melarang","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":6116,"textArabic":"عَبْدًا اِذَا صَلّٰىۗ","textLatin":"‘Abdan iżā ṣallā.","translationEn":"","translationId":"seorang hamba ketika dia melaksanakan salat?","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":6117,"textArabic":"اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىٓۙ","textLatin":"Ara'aita in kāna ‘alal-hudā.","translationEn":"","translationId":"Bagaimana pendapatmu kalau terbukti dia berada di dalam kebenaran","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":6118,"textArabic":"اَوْ اَمَرَ بِالتَّقْوٰىۗ","textLatin":"Au amara bit-taqwā.","translationEn":"","translationId":"atau dia menyuruh bertakwa (kepada Allah)?","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":6119,"textArabic":"اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۗ","textLatin":"Ara'aita in każżaba wa tawallā.","translationEn":"","translationId":"Bagaimana pendapatmu kalau dia mendustakan (kebenaran) dan berpaling (dari keimanan)?","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":6120,"textArabic":"اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۗ","textLatin":"Alam ya‘lam bi'annallāha yarā.","translationEn":"","translationId":"Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":6121,"textArabic":"كَلَّا لَىِٕنْ لَّمْ يَنْتَهِ ەۙ لَنَسْفَعًاۢ بِالنَّاصِيَةِۙ","textLatin":"Kallā la'il lam yantah(i), lanasfa‘am bin-nāṣiyah(ti).","translationEn":"","translationId":"Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian), niscaya Kami tarik ubun-ubunnya (ke dalam neraka),","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":6122,"textArabic":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ","textLatin":"Nāṣiyatin kāżibatin khāṭi'ah(tin).","translationEn":"","translationId":"(yaitu) ubun-ubun orang yang mendustakan (kebenaran) dan durhaka.","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":6123,"textArabic":"فَلْيَدْعُ نَادِيَهٗۙ","textLatin":"Falyad‘u nādiyah(ū).","translationEn":"","translationId":"Biarlah dia memanggil golongannya (untuk menolongnya).","tafsirId":"","juz":30},{"numberInSurah":18,"numberInQuran":6124,"textArabic":"سَنَدْعُ الزَّبَانِيَةَۙ","textLatin":"Sanad‘uz-zabāniyah(ta).","translationEn":"","translationId":"Kelak Kami akan memanggil (Malaikat) Zabaniah (penyiksa orang-orang yang berdosa).","tafsirId":"","juz":30},{"numberInSurah":19,"numberInQuran":6125,"textArabic":"كَلَّاۗ  لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩ ࣖ","textLatin":"Kallā, lā tuṭi‘hu wasjud waqtarib.","translationEn":"","translationId":"Sekali-kali tidak! Janganlah patuh kepadanya, (tetapi) sujud dan mendekatlah (kepada Allah).","tafsirId":"","juz":30}]