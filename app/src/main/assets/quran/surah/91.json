[{"numberInSurah":1,"numberInQuran":6044,"textArabic":"وَالشَّمْسِ وَضُحٰىهَاۖ","textLatin":"Wasy-syamsi wa ḍuḥāhā.","translationEn":"","translationId":"Demi matahari dan sinarnya pada waktu duha (ketika matahari naik sepenggalah),","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6045,"textArabic":"وَالْقَمَرِ اِذَا تَلٰىهَاۖ","textLatin":"Wal-qamari iżā talāhā.","translationEn":"","translationId":"demi bulan saat mengiringinya,","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6046,"textArabic":"وَالنَّهَارِ اِذَا جَلّٰىهَاۖ","textLatin":"Wan-nahāri iżā jallāhā.","translationEn":"","translationId":"demi siang saat menampakkannya,","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6047,"textArabic":"وَالَّيْلِ اِذَا يَغْشٰىهَاۖ","textLatin":"Wal-laili iżā yagsyāhā.","translationEn":"","translationId":"demi malam saat menutupinya (gelap gulita),","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":6048,"textArabic":"وَالسَّمَاۤءِ وَمَا بَنٰىهَاۖ","textLatin":"Was-samā'i wa mā banāhā.","translationEn":"","translationId":"demi langit serta pembuatannya,","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":6049,"textArabic":"وَالْاَرْضِ وَمَا طَحٰىهَاۖ","textLatin":"Wal-arḍi wa mā ṭaḥāhā.","translationEn":"","translationId":"demi bumi serta penghamparannya,","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":6050,"textArabic":"وَنَفْسٍ وَّمَا سَوّٰىهَاۖ","textLatin":"Wa nafsiw wa mā sawwāhā.","translationEn":"","translationId":"dan demi jiwa serta penyempurnaan (ciptaan)-nya,","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":6051,"textArabic":"فَاَلْهَمَهَا فُجُوْرَهَا وَتَقْوٰىهَاۖ","textLatin":"Fa alhamahā fujūrahā wa taqwāhā.","translationEn":"","translationId":"lalu Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":6052,"textArabic":"قَدْ اَفْلَحَ مَنْ زَكّٰىهَاۖ","textLatin":"Qad aflaḥa man zakkāhā.","translationEn":"","translationId":"sungguh beruntung orang yang menyucikannya (jiwa itu)","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":6053,"textArabic":"وَقَدْ خَابَ مَنْ دَسّٰىهَاۗ","textLatin":"Wa qad khāba man dassāhā.","translationEn":"","translationId":"dan sungguh rugi orang yang mengotorinya.","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":6054,"textArabic":"كَذَّبَتْ ثَمُوْدُ بِطَغْوٰىهَآ  ۖ","textLatin":"Każżabat ṡamūdu biṭagwāhā.","translationEn":"","translationId":"(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":6055,"textArabic":"اِذِ انْۢبَعَثَ اَشْقٰىهَاۖ","textLatin":"Iżimba‘aṡa asyqāhā.","translationEn":"","translationId":"ketika orang yang paling celaka di antara mereka bangkit (untuk menyembelih unta betina Allah).","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":6056,"textArabic":"فَقَالَ لَهُمْ رَسُوْلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْيٰهَاۗ","textLatin":"Fa qāla lahum rasūlullāhi nāqatallāhi wa suqyāhā.","translationEn":"","translationId":"Rasul Allah (Saleh) lalu berkata kepada mereka, “(Biarkanlah) unta betina Allah ini beserta minumannya.”","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":6057,"textArabic":"فَكَذَّبُوْهُ فَعَقَرُوْهَاۖ فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْۢبِهِمْ فَسَوّٰىهَاۖ","textLatin":"Fa każżabūhu fa ‘aqarūhā fa damdama ‘alaihim rabbuhum biżambihim fa sawwāhā.","translationEn":"","translationId":"Namun, mereka kemudian mendustakannya (Saleh) dan menyembelih (unta betina) itu. Maka, Tuhan membinasakan mereka karena dosa-dosanya, lalu meratakan mereka (dengan tanah).","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":6058,"textArabic":"وَلَا يَخَافُ عُقْبٰهَا ࣖ","textLatin":"Wa lā yakhāfu ‘uqbāhā.","translationEn":"","translationId":"Dia tidak takut terhadap akibatnya.","tafsirId":"","juz":30}]