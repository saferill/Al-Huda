h":26,"numberInQuran":5826,"textArabic":"فَاَيْنَ تَذْهَبُوْنَۗ","textLatin":"Fa aina tażhabūn(a).","translationEn":"","translationId":"Maka, ke manakah kamu akan pergi?","tafsirId":"","juz":30},{"numberInSurah":27,"numberInQuran":5827,"textArabic":"اِنْ هُوَ اِلَّا ذِكْرٌ لِّلْعٰلَمِيْنَۙ","textLatin":"In huwa illā żikrul lil-‘ālamīn(a).","translationEn":"","translationId":"(Al-Qur’an) itu tidak lain, kecuali peringatan bagi semesta alam,","tafsirId":"","juz":30},{"numberInSurah":28,"numberInQuran":5828,"textArabic":"لِمَنْ شَاۤءَ مِنْكُمْ اَنْ يَّسْتَقِيْمَۗ","textLatin":"Liman syā'a minkum ay yastaqīm(a).","translationEn":"","translationId":"(yaitu) bagi siapa di antaramu yang hendak menempuh jalan yang lurus.","tafsirId":"","juz":30},{"numberInSurah":29,"numberInQuran":5829,"textArabic":"وَمَا تَشَاۤءُوْنَ اِلَّآ اَنْ يَّشَاۤءَ اللّٰهُ رَبُّ الْعٰلَمِيْنَ ࣖ","textLatin":"Wa mā tasyā'ūna illā ay yasyā'allāhu rabbul-‘ālamīn(a).","translationEn":"","translationId":"Kamu tidak dapat berkehendak, kecuali apabila dikehendaki Allah, Tuhan semesta alam.","tafsirId":"","juz":30}]