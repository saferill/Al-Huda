[{"numberInSurah":1,"numberInQuran":6158,"textArabic":"اَلْقَارِعَةُۙ","textLatin":"Al-qāri‘ah(tu).","translationEn":"","translationId":"Al-Qāri‘ah (hari Kiamat yang menggetarkan).","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":6159,"textArabic":"مَا الْقَارِعَةُ ۚ","textLatin":"Mal-qāri‘ah(tu).","translationEn":"","translationId":"Apakah al-Qāri‘ah itu?","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":6160,"textArabic":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","textLatin":"Wa mā adrāka mal-qāri‘ah(tu).","translationEn":"","translationId":"Tahukah kamu apakah al-Qāri‘ah itu?","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":6161,"textArabic":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","textLatin":"Yauma yakūnun-nāsu kal-farāsyil-mabṡūṡ(i).","translationEn":"","translationId":"Pada hari itu manusia seperti laron yang beterbangan","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":6162,"textArabic":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","textLatin":"Wa takūnul-jibālu kal-‘ihnil-manfūsy(i).","translationEn":"","translationId":"dan gunung-gunung seperti bulu yang berhamburan.","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":6163,"textArabic":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ ","textLatin":"Fa ammā man ṡaqulat mawāzīnuh(ū).","translationEn":"","translationId":"Siapa yang berat timbangan (kebaikan)-nya,","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":6164,"textArabic":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","textLatin":"Fa huwa fī ‘īsyatir rāḍiyah(tin).","translationEn":"","translationId":"dia berada dalam kehidupan yang menyenangkan.","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":6165,"textArabic":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","textLatin":"Wa ammā man khaffat mawāzīnuh(ū).","translationEn":"","translationId":"Adapun orang yang ringan timbangan (kebaikan)-nya,","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":6166,"textArabic":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","textL