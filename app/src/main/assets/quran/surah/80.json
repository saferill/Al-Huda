[{"numberInSurah":1,"numberInQuran":5759,"textArabic":"عَبَسَ وَتَوَلّٰىٓۙ","textLatin":"‘Abasa wa tawallā.","translationEn":"","translationId":"Dia (Nabi Muhammad) berwajah masam dan berpaling","tafsirId":"","juz":30},{"numberInSurah":2,"numberInQuran":5760,"textArabic":"اَنْ جَاۤءَهُ الْاَعْمٰىۗ","textLatin":"An jā'ahul-a‘mā.","translationEn":"","translationId":"karena seorang tunanetra (Abdullah bin Ummi Maktum) telah datang kepadanya.","tafsirId":"","juz":30},{"numberInSurah":3,"numberInQuran":5761,"textArabic":"وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰىٓۙ","textLatin":"Wa mā yudrīka la‘allahū yazzakkā.","translationEn":"","translationId":"Tahukah engkau (Nabi Muhammad) boleh jadi dia ingin menyucikan dirinya (dari dosa)","tafsirId":"","juz":30},{"numberInSurah":4,"numberInQuran":5762,"textArabic":"اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۗ","textLatin":"Au yażżakkaru fatanfa‘ahuż-żikrā.","translationEn":"","translationId":"atau dia (ingin) mendapatkan pengajaran sehingga pengajaran itu bermanfaat baginya?","tafsirId":"","juz":30},{"numberInSurah":5,"numberInQuran":5763,"textArabic":"اَمَّا مَنِ اسْتَغْنٰىۙ","textLatin":"Ammā manistagnā.","translationEn":"","translationId":"Adapun orang yang merasa dirinya serba cukup (para pembesar Quraisy),","tafsirId":"","juz":30},{"numberInSurah":6,"numberInQuran":5764,"textArabic":"فَاَنْتَ لَهٗ تَصَدّٰىۗ","textLatin":"Fa anta lahū taṣaddā.","translationEn":"","translationId":"engkau (Nabi Muhammad) memberi perhatian kepadanya.","tafsirId":"","juz":30},{"numberInSurah":7,"numberInQuran":5765,"textArabic":"وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۗ","textLatin":"Wa mā ‘alaika allā yazzakkā.","translationEn":"","translationId":"Padahal, tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).","tafsirId":"","juz":30},{"numberInSurah":8,"numberInQuran":5766,"textArabic":"وَاَمَّا مَنْ جَاۤءَكَ يَسْعٰىۙ","textLatin":"Wa ammā man jā'aka yas‘ā.","translationEn":"","translationId":"Adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),","tafsirId":"","juz":30},{"numberInSurah":9,"numberInQuran":5767,"textArabic":"وَهُوَ يَخْشٰىۙ","textLatin":"Wa huwa yakhsyā.","translationEn":"","translationId":"sedangkan dia takut (kepada Allah),","tafsirId":"","juz":30},{"numberInSurah":10,"numberInQuran":5768,"textArabic":"فَاَنْتَ عَنْهُ تَلَهّٰىۚ","textLatin":"Fa anta ‘anhu talahhā.","translationEn":"","translationId":"malah engkau (Nabi Muhammad) abaikan.","tafsirId":"","juz":30},{"numberInSurah":11,"numberInQuran":5769,"textArabic":"كَلَّآ اِنَّهَا تَذْكِرَةٌ ۚ","textLatin":"Kallā innahā tażkirah(tun).","translationEn":"","translationId":"Sekali-kali jangan (begitu)! Sesungguhnya (ajaran Allah) itu merupakan peringatan.","tafsirId":"","juz":30},{"numberInSurah":12,"numberInQuran":5770,"textArabic":"فَمَنْ شَاۤءَ ذَكَرَهٗ ۘ","textLatin":"Faman syā'a żakarah(ū).","translationEn":"","translationId":"Siapa yang menghendaki tentulah akan memperhatikannya","tafsirId":"","juz":30},{"numberInSurah":13,"numberInQuran":5771,"textArabic":"فِيْ صُحُفٍ مُّكَرَّمَةٍۙ","textLatin":"Fī ṣuḥufim mukarrmah(tin).","translationEn":"","translationId":"di dalam suhuf yang dimuliakan (di sisi Allah),","tafsirId":"","juz":30},{"numberInSurah":14,"numberInQuran":5772,"textArabic":"مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۢ ۙ","textLatin":"Marfū‘atim muṭahharah(tin).","translationEn":"","translationId":"yang ditinggikan (kedudukannya) lagi disucikan","tafsirId":"","juz":30},{"numberInSurah":15,"numberInQuran":5773,"textArabic":"بِاَيْدِيْ سَفَرَةٍۙ","textLatin":"Bi'aidī safarah(tin).","translationEn":"","translationId":"di tangan para utusan (malaikat)","tafsirId":"","juz":30},{"numberInSurah":16,"numberInQuran":5774,"textArabic":"كِرَامٍۢ بَرَرَةٍۗ","textLatin":"Kirāmim bararah(tin).","translationEn":"","translationId":"yang mulia lagi berbudi.","tafsirId":"","juz":30},{"numberInSurah":17,"numberInQuran":5775,"textArabic":"قُتِلَ الْاِنْسَانُ مَآ اَكْفَرَهٗۗ","textLatin":"Qutilal-insānu mā akfarah(ū).","translationEn":